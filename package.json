{
  "name": "spactureai-mobile-player",
  "version": "1.0.36",
  "packageManager": "yarn@3.6.1",
  "description": "Spacture AI Mobile Player",
  "source": "./src/index.tsx",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "author": "Spacture AI",
  "exports": {
    ".": {
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-unified-player-example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "prepare-publish": "yarn clean && yarn prepare",
    "release": "release-it",
    "specs": "nitrogen"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spacture-AI/react-native-unified-player.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Spacture-AI/react-native-unified-player/issues"
  },
  "homepage": "https://github.com/Spacture-AI/react-native-unified-player#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@evilmartians/lefthook": "^1.5.0",
    "@expo/config-plugins": "^54.0.4",
    "@react-native/eslint-config": "^0.78.0",
    "@release-it/conventional-changelog": "^8.0.0",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.0.0",
    "commitlint": "^19.6.1",
    "del-cli": "^5.1.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "nitrogen": "^0.35.0",
    "prettier": "^3.0.3",
    "react": "19.0.0",
    "react-native": "0.78.2",
    "react-native-builder-bob": "^0.40.6",
    "react-native-nitro-modules": "^0.35.0",
    "release-it": "^17.10.0",
    "turbo": "^2.9.14",
    "typescript": "^5.2.2"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.35.0"
  },
  "workspaces": [
    "example"
  ],
  "resolutions": {
    "basic-ftp": "^5.2.2",
    "fast-xml-parser": "^5.7.0",
    "handlebars": "^4.7.9",
    "lodash": "^4.18.0",
    "node-forge": "^1.4.0",
    "on-headers": "^1.1.0",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "brace-expansion@^1.1.7": "^1.1.13",
    "brace-expansion@^2.0.1": "^2.0.3",
    "@xmldom/xmldom": "^0.8.13",
    "fast-uri": "^3.1.2",
    "flatted": "^3.4.2",
    "ip-address": "^10.1.1",
    "js-yaml@^3.13.1": "^3.14.2",
    "js-yaml@^4.1.0": "^4.1.1",
    "yaml": "^2.8.3",
    "@conventional-changelog/git-client": "^2.0.0",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "minimatch@^3.0.4": "^3.1.3",
    "minimatch@^3.1.1": "^3.1.3",
    "minimatch@^3.1.2": "^3.1.3",
    "minimatch@^5.0.1": "^5.1.8",
    "minimatch@^8.0.2": "^8.0.6",
    "minimatch@^9.0.4": "^9.0.7",
    "minimatch@^10.0.1": "^10.2.3",
    "minimatch@^10.1.1": "^10.2.3",
    "picomatch@^2.0.4": "^2.3.2",
    "picomatch@^2.2.3": "^2.3.2",
    "picomatch@^2.3.1": "^2.3.2",
    "picomatch@^4.0.3": "^4.0.4",
    "tar": "^7.5.11",
    "glob@^7.0.0": "^7.2.3",
    "glob@^7.1.1": "^7.2.3",
    "glob@^7.1.3": "^7.2.3",
    "glob@^7.1.4": "^7.2.3",
    "glob@^10.2.2": "^10.5.0",
    "shell-quote": "^1.8.4"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": false,
      "push": true,
      "pushArgs": [
        "--force-with-lease"
      ]
    },
    "npm": {
      "publish": true,
      "publishPath": "."
    },
    "github": {
      "release": true,
      "autoGenerate": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "ignoreRecommendedBump": true
      }
    },
    "hooks": {
      "before:npm:publish": "yarn prepare-publish"
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "type": "legacy-view",
    "languages": "kotlin-objc",
    "version": "0.49.8"
  },
  "codegenConfig": {
    "name": "RNCVideoViewSpec",
    "type": "components",
    "jsSrcsDir": "src/spec/fabric",
    "android": {
      "javaPackageName": "com.facebook.react.viewmanagers"
    }
  }
}
